
@{
    Layout = null;
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f5f7fa;
        font-family: Arial, Helvetica, sans-serif;
    }

    .thank-you-container {
        width: 100%;
        max-width: 600px;
        margin: 100px auto;
        padding: 50px 40px;
        background: #ffffff;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
    }

    .success-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 25px;
        border-radius: 50%;
        background: #e8f5e9;
        color: #28a745;
        font-size: 38px;
        line-height: 70px;
        font-weight: bold;
    }

    .thank-you-container h1 {
        margin: 0 0 15px;
        color: #222;
        font-size: 32px;
        font-weight: 600;
    }

    .thank-you-container p {
        margin: 0 0 30px;
        color: #666;
        font-size: 16px;
        line-height: 1.6;
    }

    .back-button {
        display: inline-block;
        padding: 13px 28px;
        border-radius: 7px;
        background: #0078d4;
        color: #ffffff;
        text-decoration: none;
        font-size: 15px;
        font-weight: 600;
        transition: background 0.2s ease;
    }

        .back-button:hover {
            background: #005ea8;
        }


            .thank-you-container h1 {
                font-size: 27px;
            }
    }
</style>


<div class="thank-you-container">

    <div class="success-icon">
        ✓
    </div>

    <h1>Thank You!</h1>

    <p>
        Your message has been submitted successfully.
        We will get back to you as soon as possible.
    </p>

    <a href="/" class="back-button">
        Back to Contact Us
    </a>

</div>

