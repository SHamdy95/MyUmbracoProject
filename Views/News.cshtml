@using MyUmbracoProject.Models;
@model IEnumerable<NewsContainerViewModel>

@{
    Layout = null;
  
}




<section class="news-section">

    <div class="news-container">

        <div class="news-header">
            <h1>Latest News</h1>
            <p>Stay up to date with our latest news and announcements.</p>
            <a asp-controller="ContactUs" asp-action="Index" class="contact-button">
                Contact Us
            </a>
        </div>

        @foreach (var container in Model)
        {
            <div class="news-container-group">
                @if (container.NewsItems.Count() > 0)
                {
                    <h2>@container.Title</h2>

                    <div class="news-grid">

                        @foreach (var news in container.NewsItems)
                        {
                            <article class="news-card">

                                @if (!string.IsNullOrEmpty(news.ImageUrl))
                                {
                                    <div class="news-image">
                                        <img src="@news.ImageUrl"
                                        alt="@news.Title" />
                                    </div>
                                }

                                <div class="news-content">

                                    @if (news.PublishDate.HasValue)
                                    {
                                        <div class="news-date">
                                            @news.PublishDate.Value.ToString("dd MMM yyyy")
                                        </div>
                                    }

                                <h2>@news.Title</h2>

                                <p>@news.Brief</p>

                                <a href="@news.Url" target="_blank"
                                   class="read-more">
                                    Read More →
                                </a>

                            </div>

                        </article>
                    }

                </div>
                }

            </div>
        }

    </div>

</section>
<style>

    .news-section {
        padding: 60px 20px;
        background: #f5f6f8;
    }

    .news-container {
        max-width: 1200px;
        margin: auto;
    }

    .news-header {
        text-align: center;
        margin-bottom: 40px;
    }

        .news-header h1 {
            font-size: 40px;
            margin-bottom: 10px;
        }

        .news-header p {
            color: #777;
        }

    .news-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .news-card {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 15px rgba(0,0,0,.08);
    }

    .news-image {
        height: 220px;
        overflow: hidden;
    }

        .news-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

    .news-content {
        padding: 25px;
    }

    .news-date {
        font-size: 14px;
        color: #888;
        margin-bottom: 10px;
    }

    .news-content h2 {
        font-size: 22px;
        margin-bottom: 12px;
    }

    .news-content p {
        color: #666;
        line-height: 1.6;
    }

    .read-more {
        display: inline-block;
        margin-top: 15px;
        text-decoration: none;
        font-weight: bold;
    }

</style>