
@using MyUmbracoProject.Models
@model ContactFormViewModel

@{
    Layout = null;

    var model = new ContactFormViewModel();
}

<style>
    * {
        box-sizing: border-box;
    }

    body {
        margin: 0;
        padding: 0;
        background: #f5f7fa;
        font-family: Arial, Helvetica, sans-serif;
    }

    .contact-form-wrapper {
        width: 100%;
        max-width: 700px;
        margin: 60px auto;
        padding: 40px;
        background: #ffffff;
        border-radius: 12px;
        box-shadow: 0 5px 25px rgba(0, 0, 0, 0.08);
    }

        .contact-form-wrapper h2 {
            margin: 0 0 10px;
            text-align: center;
            font-size: 30px;
            color: #222;
        }

        .contact-form-wrapper .form-description {
            margin: 0 0 30px;
            text-align: center;
            color: #777;
            font-size: 15px;
        }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #333;
            font-size: 14px;
            font-weight: 600;
        }

        .form-group input,
        .form-group textarea {
            width: 100%;
            padding: 13px 15px;
            border: 1px solid #d8dce2;
            border-radius: 7px;
            background: #fff;
            font-size: 15px;
            color: #333;
            outline: none;
            transition: all 0.2s ease;
        }

        .form-group input {
            height: 48px;
        }

        .form-group textarea {
            min-height: 150px;
            resize: vertical;
        }

            .form-group input:focus,
            .form-group textarea:focus {
                border-color: #0078d4;
                box-shadow: 0 0 0 3px rgba(0, 120, 212, 0.12);
            }

            .form-group input::placeholder,
            .form-group textarea::placeholder {
                color: #aaa;
            }

    .field-validation-error {
        display: block;
        margin-top: 6px;
        color: #d93025;
        font-size: 13px;
    }

    .submit-button {
        width: 100%;
        height: 48px;
        margin-top: 10px;
        border: none;
        border-radius: 7px;
        background: #0078d4;
        color: white;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .submit-button:hover {
            background: #005ea8;
        }

        .submit-button:active {
            transform: scale(0.99);
        }



            .contact-form-wrapper h2 {
                font-size: 25px;
            }
    }
</style>


<div class="contact-form-wrapper">

    <h2>Contact Us</h2>

    <p class="form-description">
        Please fill in the form below and we will get back to you.
    </p>

    <form asp-controller="ContactUs"
          asp-action="Submit"
          method="post">

        <div class="form-group">

            <label asp-for="FirstName"></label>

            <input asp-for="FirstName"
                   placeholder="Enter your first name" />

            <span asp-validation-for="FirstName"
                  class="field-validation-error">
            </span>

        </div>


        <div class="form-group">

            <label asp-for="Email"></label>

            <input asp-for="Email"
                   type="email"
                   placeholder="Enter your email address" />

            <span asp-validation-for="Email"
                  class="field-validation-error">
            </span>

        </div>


        <div class="form-group">

            <label asp-for="Subject"></label>

            <input asp-for="Subject"
                   placeholder="Enter the subject" />

            <span asp-validation-for="Subject"
                  class="field-validation-error">
            </span>

        </div>


        <div class="form-group">

            <label asp-for="Message"></label>

            <textarea asp-for="Message"
                      placeholder="Write your message here..."></textarea>

            <span asp-validation-for="Message"
                  class="field-validation-error">
            </span>

        </div>


        <button type="submit" class="submit-button">
            Send
        </button>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

