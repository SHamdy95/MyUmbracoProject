@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.NewsContainer>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;
@{
	Layout = null;

}

@foreach (var news in Model.Children())
{
    <div>
        <h2>@news.Name</h2>
    </div>
    @foreach (var items  in news.Children())
    {
        <div>
            <h2>@items.Name</h2>
        </div>
    }
}