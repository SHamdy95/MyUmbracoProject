@using Umbraco.Cms.Web.Common.PublishedModels;
@inherits Umbraco.Cms.Web.Common.Views.UmbracoViewPage<ContentModels.New>
@using ContentModels = Umbraco.Cms.Web.Common.PublishedModels;


@{
    Layout = null;

    var title = Model.Value<string>("title");
    var brief = Model.Value<string>("brief");
    var image = Model.Value<IPublishedContent>("image");
    var publishDate = Model.Value<DateTime?>("publishDate");
    var expiryDate = Model.Value<DateTime?>("expiryDate");
}


<section class="news-section"> <div class="news-container"> <div class="news-header"> <h1>News Details</h1> </div> <div class="news-grid"> <article class="news-card"> @if (image != null) {
    <div class="news-image"> <img src="@image.Url()" alt="@title" /> </div>
}
<div class="news-content"> @if (publishDate.HasValue) {
    <div class="news-date"> @publishDate.Value.ToString("dd MMM yyyy") </div>
}
<h2> @title </h2> <p> @brief </p> </div> </article> </div> </div> </section>


<style>
.news-section {
padding: 60px 20px;
background: #f5f6f8;
}

.news-container {
max-width: 1200px;
margin: auto;
}

.news-header {
text-align: center;
margin-bottom: 40px;
}

.news-header h1 {
font-size: 40px;
margin-bottom: 10px;
}

.news-header p {
color: #777;
}

.news-grid {
display: grid;
grid-template-columns: repeat(3, 1fr);
gap: 30px;
}

.news-card {
background: #fff;
border-radius: 12px;
overflow: hidden;
box-shadow: 0 4px 15px rgba(0,0,0,.08);
}

.news-image {
height: 220px;
overflow: hidden;
}

.news-image img {
width: 100%;
height: 100%;
object-fit: cover;
}

.news-content {
padding: 25px;
}

.news-date {
font-size: 14px;
color: #888;
margin-bottom: 10px;
}

.news-content h2 {
font-size: 22px;
margin-bottom: 12px;
}

.news-content p {
color: #666;
line-height: 1.6;
}

.read-more {
display: inline-block;
margin-top: 15px;
text-decoration: none;
font-weight: bold;
}

}

</style>

